# Copy to services/api/.env and adjust. Never commit the real .env file.

ENVIRONMENT=development

# Option A (default): Docker Compose database from infra/docker-compose.yml (host port 5433).
DATABASE_URL=postgresql+psycopg://moneymentor:moneymentor_dev@localhost:5433/moneymentor
# Option B: an existing native PostgreSQL on 5432 after running infra/postgres/create_dev_db.sql.
# DATABASE_URL=postgresql+psycopg://moneymentor:moneymentor_dev@localhost:5432/moneymentor

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Not used yet. Reserved for Phase 3 (agent integration). Leave blank until then. ---
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# N8N_BASE_URL=http://localhost:5678
